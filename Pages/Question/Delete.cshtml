@page
@model TestTest.Pages.Question.DeleteModel

@{
    ViewData["Title"] = "Usuń pytanie";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="display-4">Usuń pytanie</h1>
<hr />
<h4 class="text-danger">Czy na pewno chcesz usunąć pytanie?</h4>
<div>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.Text)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.Text)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.TeacherId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.TeacherId)
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Question.Id" />
        <div class="form-group mt-3">
            <input type="submit" value="Usuń" class="btn btn-delete" />
            <a class="btn btn-back ml-2" asp-page="Index">Powrót</a>
        </div>
    </form>
</div>
