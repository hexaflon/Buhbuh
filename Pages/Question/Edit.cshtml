@page
@model TestTest.Pages.Question.EditModel

@{
    ViewData["Title"] = "Edytuj pytanie";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="display-4">Edytuj pytanie</h1>
<hr />
<div class="container">
    <div class="row">
        <div class="col-md-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Question.Id" />
                <div hidden>
                    <input asp-for="Question.TeacherId" value="@ViewBag.IdNauczyciela" />
                </div>                
                <div class="form-group">
                    <label asp-for="Question.CategoryId" class="control-label">@Html.DisplayNameFor(model => model.Question.CategoryId)</label>
                    <select asp-for="Question.CategoryId" class="form-control" asp-items="ViewBag.IdKategoriaPytania"></select>
                    <span asp-validation-for="Question.CategoryId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Question.TypeId" class="control-label">@Html.DisplayNameFor(model => model.Question.TypeId)</label>
                    <select asp-for="Question.TypeId" class="form-control" asp-items="ViewBag.IdTypPytania"></select>
                    <span asp-validation-for="Question.TypeId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Question.Text" class="control-label">@Html.DisplayNameFor(model => model.Question.Text)</label>
                    <input asp-for="Question.Text" class="form-control" />
                    <span asp-validation-for="Question.Text" class="text-danger"></span>
                </div>
                <div class="form-group mt-3">
                    <input type="submit" value="Zapisz" class="btn btn-standard" />
                    <a class="btn btn-back ml-2" asp-page="Index">Powrót</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
