@page
@model TestTest.Pages.Question.DetailsModel

@{
    ViewData["Title"] = "Szczegóły pytania";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="display-4">Szczegóły pytania</h1>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.Text)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.Text)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.Category)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.Category.Id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.TeacherId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.TeacherId)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Question.Type)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Question.Type.Id)
        </dd>
    </dl>
</div>
<div class="form-group mt-3">
    <a asp-page="./Edit" asp-route-id="@Model.Question?.Id" class="btn btn-standard">Edytuj</a>
    <a asp-page="./Index" class="btn btn-back ml-2">Powrót</a>
</div>

