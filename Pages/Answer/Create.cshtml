@page
@model TestTest.Pages.Answer.CreateModel

@{
    ViewData["Title"] = "Zarządzaj odpowiedziami";
}

<h1 class="display-4">Zarządzaj odpowiedziami</h1>
<div class="container">
    @if (Model.VisibleQuestion.Answers != null && Model.VisibleQuestion.Answers.Any())
    {
        <hr />
        <div class="row">
            <div class="col-md-4">
                <h4>Odpowiedzi</h4>
                <table class="table">
                    <thead>
                        <tr class="text-muted col-sm-3 text-center">
                            <th>Nr pytania</th>
                            <th>Treść odpowiedzi</th>
                            <th>Czy odpowiedź jest poprawna?</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var nr_pytania = 1;
                        }

                        @foreach (var odp in Model.VisibleQuestion.Answers)
                        {
                            <tr class="text1 col-sm-3 text-center">
                                <td>@nr_pytania</td>
                                <td>@Html.DisplayFor(z => odp.Text)</td>
                                <td>@Html.DisplayFor(z => odp.IsCorrect)</td>
                                <td>
                                    <a class="btn btn-delete" asp-page="./Delete" asp-route-id="@odp.Id" asp-route-idPyt="@odp.QuestionId">Usuń</a>
                                </td>
                            </tr>
                            nr_pytania++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <hr />
    }

    <div class="row">
        <div class="col-md-4">
            @if (!Model.VisibleQuestion.Answers.Any())
            {
                <p class="text2">To pytanie aktualnie nie ma żadnych odpowiedzi. Możesz dodać je poniżej.</p>
            }

            <form method="post" asp-route-id="@ViewBag.id">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="Answer.Text" class="control-label">Treść odpowiedzi</label>
                    <input asp-for="Answer.Text" class="form-control" />
                    <span asp-validation-for="Answer.Text" class="text-danger"></span>
                </div>
                <div class="form-group form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="Answer.IsCorrect" disabled="@(Model.hasCorrectAnswer ? "disabled" : null)" /> Czy odpowiedź jest poprawna?
                    </label>
                </div>
                <div class="form-group mt-3">
                    <input type="submit" value="Utwórz" class="btn btn-standard" />
                    <a class="btn btn-back ml-2" asp-page="/Question/Index">Powrót</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
