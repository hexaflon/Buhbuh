@page
@model ProjektInzynierski.Pages.Exam.EditModel

@{
    ViewData["Title"] = "Edytuj test";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="display-4">Edytuj test</h1>
<hr />
<div class="container">
    <div class="row">
        <div class="col-md-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Test.Id" />
                <input type="hidden" asp-for="Test.GroupId" value="@ViewBag.IdGrupy" />
                <input type="hidden" asp-for="Test.TeacherId" value="@ViewBag.IdNauczyciela" />

                <div class="form-group form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="Test.IsVisible" /> @Html.DisplayNameFor(model => model.Test.IsVisible)
                    </label>
                </div>
                <div class="form-group">
                    <label asp-for="Test.StartDate" class="control-label">Data rozpoczęcia</label>
                    <input asp-for="Test.StartDate" class="form-control" />
                    <span asp-validation-for="Test.StartDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Test.EndDate" class="control-label">Data zakończenia</label>
                    <input asp-for="Test.EndDate" class="form-control" />
                    <span asp-validation-for="Test.EndDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Test.Title" class="control-label">Tytuł</label>
                    <input asp-for="Test.Title" class="form-control" />
                    <span asp-validation-for="Test.Title" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Test.Description" class="control-label">Opis</label>
                    <input asp-for="Test.Description" class="form-control" />
                    <span asp-validation-for="Test.Description" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Test.Duration" class="control-label">Czas trwania</label>
                    <input asp-for="Test.Duration" class="form-control" />
                    <span asp-validation-for="Test.Duration" class="text-danger"></span>
                </div>
                <div class="form-group mt-3">
                    <input type="submit" value="Zapisz" class="btn btn-standard" />
                    <a class="btn btn-back ml-2" asp-page="./List">Powrót</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
