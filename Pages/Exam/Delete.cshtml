@page
@model ProjektInzynierski.Pages.Exam.DeleteModel

@{
    ViewData["Title"] = "Usuń test";
    ViewData["Title"] = "Usuń test";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1 class="display-4">Usuń test</h1>
<hr />
<h4 class="text-danger">Czy na pewno chcesz usunąć test?</h4>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Test.IsVisible)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Test.IsVisible)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Test.StartDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Test.StartDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Test.EndDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Test.EndDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Test.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Test.Title)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Test.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Test.Description)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Test.Duration)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Test.Duration)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Test.TeacherId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Test.TeacherId)
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Test.Id" />
        <div class="form-group mt-3">
            <input type="submit" value="Usuń" class="btn btn-delete" />
            <a class="btn btn-back ml-2" asp-page="./List">Powrót</a>
        </div>
    </form>
</div>
