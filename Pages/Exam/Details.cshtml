@page
@model ProjektInzynierski.Pages.Exam.DetailsModel

@{
    ViewData["Title"] = "Szczegóły testu";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h1 class="display-4">Szczegóły testu</h1>

    <div class="card mt-4">
        <div class="card-body">
            <h4 class="card-title">@Html.DisplayFor(model => model.Test.Title)</h4>
            <hr />

            <table class="table">
                <tbody>
                    <tr>
                        <th scope="row" class="col-sm-3 text-muted">ID nauczyciela:</th>
                        <td class="col-sm-9 text1">@Html.DisplayFor(model => model.Test.TeacherId)</td>
                    </tr>
                    <tr>
                        <th scope="row" class="col-sm-3 text-muted">Opis testu:</th>
                        <td class="col-sm-9 text1">
                            @if (String.IsNullOrEmpty(Model.Test.Description))
                            {
                                @Html.Raw("-")
                            }
                            else
                            {
                                @Html.DisplayFor(model => model.Test.Description)
                            }
                        </td>
                    </tr>
                    <tr>
                        <th scope="row" class="col-sm-3 text-muted">Średnia ocen:</th>
                        <td class="col-sm-9 text1">
                            @if (Double.IsNaN(Model.Avg))
                            {
                                @Html.Raw("-")
                            }
                            else
                            {
                                @Html.Raw($"{Model.Avg:F2}")
                            }
                        </td>
                    </tr>
                    <tr>
                        <th scope="row" class="col-sm-3 text-muted">Wyniki</th>
                        <td>
                            @if (!Model.Scores.Any())
                            {
                                <p class="text1">Brak wyników.</p>
                            }
                            else
                            {
                                <div class="row text-muted row1">
                                    <div class="col-sm-1">
                                        <strong>ID</strong>
                                    </div>
                                    <div class="col-sm-3 text-center">
                                        <strong>Nazwisko i imię</strong>
                                    </div>
                                    <div class="col-sm-2 text-center">
                                        <strong>Ilość punktów</strong>
                                    </div>
                                    <div class="col-sm-2 text-center">
                                        <strong>Ocena</strong>
                                    </div>
                                </div>

                                @for (int i = 0; i < Model.Scores.Count; i++)
                                {
                                    <div class="row text1">
                                        <div class="col-sm-1">
                                            @Html.Raw($"{Model.Scores[i].studentId}")
                                        </div>
                                        <div class="col-sm-3 text-center">
                                            @Html.Raw($"{Model.Scores[i].surname} {Model.Scores[i].name}")
                                        </div>
                                        <div class="col-sm-2 text-center">
                                            @Html.Raw($"{Model.Scores[i].message}")
                                        </div>
                                        <div class="col-sm-2 text-center">
                                            @Model.Mark[i]
                                        </div>
                                        <div class="col-sm-3 text-center">
                                            <a class="btn btn-details" asp-page="./ExamInfo" asp-route-id="@Model.Results[i].Id">Zobacz więcej</a>
                                        </div>
                                    </div>
                                    <br />
                                }
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a class="btn btn-back" asp-page="./List">Powrót</a>
    </div>
</div>
